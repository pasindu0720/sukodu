# -----------------
# Add-ons
# -----------------
start_time = time.time()
mistakes = 0

def update_timer(label, root):
    elapsed = int(time.time() - start_time)
    minutes = elapsed // 60
    seconds = elapsed % 60
    label.config(text=f"Time: {minutes:02d}:{seconds:02d}")
    root.after(1000, update_timer, label, root)

def add_mistake(label):
    global mistakes
    mistakes += 1
    label.config(text=f"Mistakes: {mistakes}")

def give_hint(grid, possible, refresh_grid):
    for r in range(9):
        for c in range(9):
            if grid[r][c] == 0:
                for n in range(1, 10):
                    if possible(r, c, n):
                        grid[r][c] = n
                        refresh_grid()
                        return

def save_game(grid, mistakes):
    data = {"grid": grid, "mistakes": mistakes}
    with open("sudoku_save.json", "w") as f:
        json.dump(data, f)
    messagebox.showinfo("Sudoku", "Game Saved")

def load_game(grid):
    global mistakes
    try:
        with open("sudoku_save.json", "r") as f:
            data = json.load(f)
        for i in range(9):
            for j in range(9):
                grid[i][j] = data["grid"][i][j]
        mistakes = data["mistakes"]
        return mistakes
    except:
        messagebox.showerror("Sudoku", "No saved game found")
        return mistakes

# -----------------
# Functions
# -----------------
def apply_theme():
    bg = DARK_BG if dark_mode else LIGHT_BG
    cell_bg = DARK_CELL if dark_mode else LIGHT_CELL
    root.configure(bg=bg)
    frame.configure(bg=bg)
    num_frame.configure(bg=bg)
    control_frame.configure(bg=bg)

    for i in range(9):
        for j in range(9):
            if original[i][j] != 0:
                cells[i][j].config(bg=ORIGINAL_CELL)
            else:
                # shadings for 3x3 blocks
                cells[i][j].config(bg=cell_bg if (i//3 + j//3) % 2 == 0 else "#e8e8e8")
            cells[i][j].config(relief="flat", bd=2)

def toggle_theme():
    global dark_mode
    dark_mode = not dark_mode
    apply_theme()

def highlight(r,c):
    for i in range(9):
        for j in range(9):
            if original[i][j] != 0:
                continue
            # removing highlight
            cells[i][j].config(relief="flat")
    cells[r][c].config(relief="solid", bd=3)

def select_cell(r,c):
    global selected
    selected = (r,c)
    highlight(r,c)

def refresh_grid():
    for i in range(9):
        for j in range(9):
            val = grid[i][j]
            cells[i][j].config(text=str(val) if val != 0 else "")
    apply_theme()

def possible(r,c,n):
    # checks row
    if n in grid[r]:
        return False
    # checks column
    for i in range(9):
        if grid[i][c] == n:
            return False
    # checks block
    start_r = (r//3)*3
    start_c = (c//3)*3
    for i in range(3):
        for j in range(3):
            if grid[start_r+i][start_c+j] == n:
                return False
    return True

def place_number(n):
    global selected
    if not selected:
        return
    r,c = selected
    if original[r][c] != 0:
        return
    if possible(r,c,n):
        grid[r][c] = n
        refresh_grid()
    else:
        add_mistake(mistakes_label)
        messagebox.showerror("Sudoku","Invalid Move")

def clear_cell():
    global selected
    if not selected:
        return
    r,c = selected
    if original[r][c] != 0:
        return
    grid[r][c] = 0
    refresh_grid()

def reset_board():
    global mistakes
    mistakes = 0
    for i in range(9):
        for j in range(9):
            grid[i][j] = original[i][j]
    refresh_grid()
    mistakes_label.config(text=f"Mistakes: {mistakes}")

def on_hint():
    give_hint(grid, possible, refresh_grid)

def on_save():
    save_game(grid, mistakes)

def on_load():
    global mistakes
    mistakes = load_game(grid)
    refresh_grid()
    mistakes_label.config(text=f"Mistakes: {mistakes}")

def on_enter_cell(r, c):
    global hovered
    hovered = (r, c)
    if not selected:
        highlight(r, c)

def on_leave_cell():
    global hovered
    hovered = None
    if selected:
        highlight(selected[0], selected[1])
    else:
        refresh_grid()

def is_complete_and_correct():
    for i in range(9):
        for j in range(9):
            if grid[i][j]==0 or not possible(i,j,grid[i][j]):
                return False
    return True

def check_solution():
    if is_complete_and_correct():
        messagebox.showinfo("Sudoku"," You solved it!")
    else:
        messagebox.showerror("Sudoku"," Not solved yet")

